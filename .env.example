# Copy to .env. Never commit real values.

# WordPress
WP_BASE_URL=https://example.com
WP_USERNAME=editor
WP_APP_PASSWORD=
WP_AUTHOR_ID=1
WP_DEFAULT_STATUS=draft
WP_TIMEOUT=30

# LLM — local first. No public unauthenticated endpoint.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:9b-instruct-q4_K_M
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2500
LLM_TIMEOUT=180

# Editorial memory
MEMORY_DB=./data/editorial.sqlite
EMBED_MODEL=nomic-embed-text
DEDUP_MIN_SCORE=0.78

# HTTP API (middleware). Bind localhost behind a reverse proxy.
API_HOST=127.0.0.1
API_PORT=8787
API_TOKEN=
API_RATE_LIMIT=20

# Email ingest (optional, IMAP). Disabled unless SATIRA_EMAIL_ENABLED=1
SATIRA_EMAIL_ENABLED=0
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SUBJECT_PREFIX=[SATIRA]

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/satira.log
